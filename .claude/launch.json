{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "charts",
            "runtimeExecutable": "python",
            "runtimeArgs": ["openalgo-pinets/app.py"],
            "port": 5055
        },
        {
            "name": "ui",
            "runtimeExecutable": "python",
            "runtimeArgs": ["-m", "streamlit", "run", "ui.py", "--server.port", "8501", "--server.headless", "true"],
            "port": 8501
        },
        {
            "name": "api",
            "runtimeExecutable": "python",
            "runtimeArgs": ["-m", "api", "--host", "127.0.0.1", "--port", "8600", "--allow-origin", "http://localhost:3200"],
            "port": 8600
        },
        {
            "name": "web",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["-C", "web", "dev", "--port", "3200"],
            "port": 3200
        }
    ]
}
