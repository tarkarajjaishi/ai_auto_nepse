# The data archive — ~5.8 GB across 300k+ files, regenerated by the fetch scripts.
# Never belongs in git; run `python daily_update.py` to rebuild it.
Master_data/

# Python caches
__pycache__/
*.pyc
*.pyo

# Secrets — NAASA's session cookie (naasa_session.txt) and, when "remember me" is on, the login
# (naasa_login.txt, plain text) are saved under Master_data/, already ignored above. Keep .env out too.
.env
.env.*
.streamlit/secrets.toml

# Runtime logs
update_log.txt

# Third-party tools that were vendored then dropped
data-formulator/
PineTS/
openalgo-pinets/

# Scratch
*.tmp
baseline.json

# Manual data exports (SWP screener etc.) — data lives in Master_data/*.txt, not in git
*.xlsx
