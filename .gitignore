# The data archive — ~5.8 GB across 300k+ files, regenerated by the fetch scripts.
# Never belongs in git; run `python daily_update.py` to rebuild it.
Master_data/

# Python caches
__pycache__/
*.pyc
*.pyo

# Secrets — the NAASA token lives in an env var, never on disk
.env
.env.*
.streamlit/secrets.toml

# Runtime logs
update_log.txt

# Third-party tools that were vendored then dropped
data-formulator/
PineTS/
openalgo-pinets/

# Scratch
*.tmp
baseline.json
