# Build output and dependencies — regenerated by `pnpm install && pnpm build`.
# The deploy ships .next/standalone as a tarball, so none of this belongs in git.
/node_modules
/.next
/out

# Local env. next.config has no secrets; anything here would poison the prod
# bundle, which is exactly how a localhost URL got baked in once before.
.env*.local

# Editor / OS noise
.DS_Store
*.tsbuildinfo
next-env.d.ts
